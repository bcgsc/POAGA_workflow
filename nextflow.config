// pipeline input parameters

// Mandatory
params.input_csv = null
params.output_folder = null

// Optional
params.min_reads_threshold = 10000
params.chromosomes = "chr1,chr2,chr3,chr4,chr5,chr6,chr7,chr8,chr9,chr10,chr11,chr12,chr13,chr14,chr15,chr16,chr17,chr18,chr19,chr20,chr21,chr22"
params.min_ashleys_qc_prob = 0.5
params.logfile = "tool_versions.yml"
params.variants = ""
params.idmr_regions_file = "${projectDir}/assets/Imprinted_DMR_List_V1.tsv"
params.flanking_region_size = 10000
params.het_hom_threshold = 0.03
params.help = ""
params.extra_strandseq_options = ""

// SNP concordance:
// chr1    1000000 10000000
params.snp_region = "${projectDir}/assets/snp_regions.bed"
params.snp_discordance_threshold = 0.03

params.debug = false
params.singularity_folder = "/projects/poaga/singularity"


manifest {
  name = 'Parent of Origin-Aware Genomic Analysis pipeline'
  mainScript = 'poaga_workflow.nf'
  nextflowVersion = '!>=23.04.4'
  version = '0.2.2'
}

//default process params.  Can be split into process specific if need be.
process {
  executor = 'slurm'
  // default resources - only very light processes should use it, other processes should
  // a memory label below:
  cpus = 2
  memory = 4.GB

  // specify memory/retry resources with the following labels:
  errorStrategy = 'retry'
  // default is to retry for all processes
  withLabel: mem350 {
    memory = { 125.GB * (1.25 * task.attempt) }
    maxRetries = 3
  }
  withLabel: mem256 {
    memory = { 256.GB * task.attempt }
    maxRetries = 2
  }
  withLabel: mem64 {
    memory = { 64.GB * task.attempt }
    maxRetries = 3
  }
  withLabel: mem32 {
    memory = { 32.GB * task.attempt }
    maxRetries = 3
  }
  withLabel: mem12 {
    memory = { 12.GB * task.attempt }
    maxRetries = 3
  }

  withLabel: variants_of_interest {
    errorStrategy = 'ignore'
  }
  //gives jobs production prority
  clusterOptions = "--qos=prod"
}

executor {
  name = 'slurm'
  queueSize = 500
}

apptainer {
  autoMounts = true
  enabled = true
  cacheDir = "${params.singularity_folder}"
}

//Reference based parameters
profiles {

  clinical_priority {
    process.clusterOptions = "--qos=clinical"
  }

  hg38_no_alt {
    params.bowtie_index = "/projects/poaga/reference/"
    params.reference_genome = "/projects/poaga/reference/hg38_no_alt.fa"
    params.reference_genome_idx = "/projects/poaga/reference/hg38_no_alt.fa.fai"
  }
  test {
    // small dataset for testing/developing
    stubRun = true
    // use -stub-run instead
    params.input_csv = "example_minimal_samples.csv"
    params.min_reads_threshold = 500
    params.chromosomes = "chr19"
    params.min_ashleys_qc_prob = 0
    params.variants = "/projects/poaga/analysis/minimal_test_set/dataset/chr19.impr.inv.1M/variants_of_interest.tsv"
    params.extra_strandseq_options = "--fix_het_invs TRUE"
  }
}
