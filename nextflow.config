
//default process params.  Can be split into process specific if need be.
process {
  executor = 'slurm'
  cpus = 6
  memory = "32 GB"
  
  //gives jobs production prority
  clusterOptions = "--qos=prod"
}

executor { 
  name='slurm'
  queueSize=500 //only up to 500 jobs on the cluster at a time
}

singularity {
  autoMounts = true
  enabled = true
}

//Reference based parameters
profiles {
 
  clinical_priority {
    process.clusterOptions = "--qos=clinical"
  }

  hg38_no_alt {
    params.reference_file = "/projects/alignment_references/9606/hg38_no_alt/genome/minimap2-2.15-map-ont/hg38_no_alt_map-ont.mmi"
    params.reference_fasta = "/projects/alignment_references/9606/hg38_no_alt/genome/minimap2-2.15-map-ont/hg38_no_alt.fa"
  }
  hg38_no_alt_phage_lambda {
    params.reference_file = "/projects/alignment_references/9606/hg38_no_alt_phage_lambda/genome/minimap2-2.15-map-ont/hg38_no_alt_phage_lambda_map-ont.mmi"
    params.reference_fasta = "/projects/alignment_references/9606/hg38_no_alt_phage_lambda/genome/fasta/hg38_no_alt_phage_lambda.fa"
  }
}
