#BootStrap: docker
#From: bioconductor/bioconductor_docker:RELEASE_3_12

BootStrap: yum
OSVersion: 7
MirrorURL: http://mirror.centos.org/centos-%{OSVERSION}/%{OSVERSION}/os/x86_64/
Include: yum

%runscript
    exec Rscript /opt/call_dmrs_with_dss.R "$@" 
 
%post
    yum -y install epel-release
    yum -y update
    yum -y groupinstall "Development Tools"
    yum -y install openssl-devel bzip2-devel libffi-devel xz-devel
    yum -y install wget unzip tar bzip2 java-1.8.0-openjdk
    yum -y install curl
    yum -y install libxml2-devel
    yum -y install libpng-devel
    yum -y install ncurses-devel

    #install bgzip, samtools, tabix
    cd /opt/
    wget https://github.com/samtools/samtools/releases/download/1.17/samtools-1.17.tar.bz2
    wget https://github.com/samtools/bcftools/releases/download/1.17/bcftools-1.17.tar.bz2
    wget https://github.com/samtools/htslib/releases/download/1.17/htslib-1.17.tar.bz2
    bzip2 -d samtools-1.17.tar.bz2
    bzip2 -d bcftools-1.17.tar.bz2
    bzip2 -d htslib-1.17.tar.bz2
    tar -xvf samtools-1.17.tar
    tar -xvf bcftools-1.17.tar
    tar -xvf htslib-1.17.tar
    cd /opt/samtools-1.17; ./configure; make; make install
    cd /opt/bcftools-1.17; ./configure; make; make install
    cd /opt/htslib-1.17; ./configure; make; make install


    #Grab python
    wget https://www.python.org/ftp/python/3.9.16/Python-3.9.16.tgz
    tar xvf Python-3.9.16.tgz
    cd Python-3.9*/
    ./configure --enable-optimizations
    make altinstall
    
    #install R 4.3.0
    cd /opt/
    export R_VERSION=4.3.0
    curl -O https://cdn.rstudio.com/r/centos-7/pkgs/R-${R_VERSION}-1-1.x86_64.rpm
    yum -y install R-${R_VERSION}-1-1.x86_64.rpm
    ln -s /opt/R/${R_VERSION}/bin/R /usr/local/bin/R
    ln -s /opt/R/${R_VERSION}/bin/Rscript /usr/local/bin/Rscript

    #install patmat dependencies
    yum -y install bcftools
    yum -y install python3-devel  
    yum -y install python3-pip
    yum -y install htslib
    pip3 install pysam
    pip3 install pytabix
    pip3 install tqdm

    #install ashley's qc dependencies
    pip3 install joblib==0.16.0
    pip3 install scikit-learn==0.23.2
    pip3 install scipy==1.5.2
    pip3 install numpy==1.19.1
    pip3 install matplotlib==3.2.1
    pip3 install pandas==1.1.2
    pip3 install pysam==0.16.0.1
    pip3 install pytest==6.2.2
    pip3 install setuptools
    pip3 install modbampy==0.9.5


    #install ashley's QC
    cd /opt/
    git clone https://github.com/friendsofstrandseq/ashleys-qc.git ashleys-qc
    cd ashleys-qc
    python3 setup.py install


    cd /opt/
    git clone https://github.com/samtools/htslib.git 
    git clone https://github.com/samtools/bcftools.git
    #yum -y install zlib-devel
    yum -y install curl-devel
    yum -y install libcurl-devel

    #modbam2bed
    cd /opt/
    git clone --recursive https://github.com/epi2me-labs/modbam2bed.git
    make modbam2bed

    cd /opt/
    VERSION=1.3.0
    wget https://github.com/vahidAK/PatMat/archive/refs/tags/v"$VERSION".tar.gz && tar -xzf v"$VERSION".tar.gz
    cd PatMat-"$VERSION"/
    env_path="/opt/"
    ln -s $PWD/{patmat,Strand-seq}/* $env_path 
# Now we need to open R and install the required R packages as follows:
    Rscript -e 'install.packages("pkgconfig", repos="https://cloud.r-project.org")'
    Rscript -e 'install.packages("pkgdepends", repos="https://cloud.r-project.org")'
    Rscript -e 'install.packages("pak", repos="https://cloud.r-project.org")'
    Rscript -e 'install.packages("curl", repos="https://cloud.r-project.org")'
    Rscript -e 'library(pkgdepends); library(pkgconfig); library(pak); pak::pkg_install(c("argparse", "BSgenome.Hsapiens.UCSC.hg38", "vincent-hanlon/InvertypeR", "sys", "R.utils", "DSS", "tibble"))'

%files
